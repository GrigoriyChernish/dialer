# Скопіюйте в .env. Значення секретів у репозиторій не кладемо.
PORT=8787
JWT_SECRET=
DB_PATH=./data/dialer.db
DEMO_ORIGIN=http://localhost:8080
LOG_LEVEL=info
# LiveKit Cloud; без них дзвінки працюють без медіа (лише для розробки)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Web Push (npx web-push generate-vapid-keys); без них сповіщення про дзвінки вимкнено
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
